# Copy the backend lines into backend/.env
# Copy the frontend line into frontend/.env.local
# Leave GEMINI_API_KEY empty in this example. A real key belongs only in backend/.env.

# Backend
APP_ENV=development
# Comma-separated explicit origins. A wildcard is rejected.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=45

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
