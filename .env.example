# Copy the backend lines into backend/.env
# Copy the frontend line into frontend/.env.local
# Do not put API keys in either file. This version has no Firebase or Gemini credentials.

# Backend
APP_ENV=development
# Comma-separated explicit origins. A wildcard is rejected.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
