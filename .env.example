# Copy the backend lines into backend/.env
# Copy the frontend line into frontend/.env.local
# Leave GEMINI_API_KEY empty in this example. A real key belongs only in backend/.env.

# Backend
APP_ENV=development
# Comma-separated explicit origins. A wildcard is rejected.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=45
# Leave these empty to stay in local/demo mode. Never commit a real private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# File-check limit per client per minute. 0 disables the limit. The default is 60.
EXTRACT_RATE_LIMIT_PER_MINUTE=60

# Frontend public client configuration. These are not Admin credentials.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
